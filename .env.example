# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================================
# REAL SMS GATEWAY PROVIDERS CONFIGURATION
# Supports top international SMS gateways with reliable delivery to
# Algerian mobile networks (Mobilis +2136, Djezzy +2137, Ooredoo +2135):
# =========================================================================

# Provider Option 1: Twilio SMS Gateway (https://www.twilio.com)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
# Or Messaging Service SID:
# TWILIO_MESSAGING_SERVICE_SID="MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Provider Option 2: Vonage / Nexmo SMS Gateway (https://www.vonage.com)
VONAGE_API_KEY="your_vonage_api_key"
VONAGE_API_SECRET="your_vonage_api_secret"
VONAGE_FROM="Sari3"

# Provider Option 3: Infobip Enterprise SMS (https://www.infobip.com)
INFOBIP_BASE_URL="your-subdomain.api.infobip.com"
INFOBIP_API_KEY="your_infobip_api_key"
INFOBIP_FROM="Sari3"

# Provider Option 4: Direct Algerian / Custom HTTP SMS Gateway
# SMS_GATEWAY_URL="https://your-sms-api.com/v1/send"
# SMS_API_KEY="your_api_key"

