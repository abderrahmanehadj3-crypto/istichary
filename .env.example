# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE OAUTH 2.0 CONFIGURATION:
# 1. Obtain Client ID and Secret from Google Cloud Console > APIs & Services > Credentials
# 2. Add Authorized JavaScript Origins:
#    - https://oqdngfhupadfirmsfbfj.supabase.co
#    - https://sari3.vercel.app (your Vercel production domain)
#    - https://ais-dev-okxpapdl7kyfariyvregal-889315027566.europe-west2.run.app
#    - http://localhost:3000
# 3. Add Authorized Redirect URIs:
#    - https://oqdngfhupadfirmsfbfj.supabase.co/auth/v1/callback
#    - https://sari3.vercel.app
#    - https://ais-dev-okxpapdl7kyfariyvregal-889315027566.europe-west2.run.app
#    - http://localhost:3000
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# VITE_VERCEL_APP_URL: Vercel production domain for client-side redirection and authentication callbacks
VITE_VERCEL_APP_URL="https://sari3.vercel.app"

# VITE_ADMIN_DASHBOARD_URL: External admin dashboard URL (e.g. hosted on Vercel)
VITE_ADMIN_DASHBOARD_URL="https://sari3-admin.vercel.app"
VITE_KEY_ADMIN_URL="https://sari3-admin.vercel.app"

# SUPABASE CONFIGURATION: Production project and public key
VITE_SUPABASE_URL="https://oqdngfhupadfirmsfbfj.supabase.co"
