# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================================
# OFFICIAL META WHATSAPP BUSINESS CLOUD API CONFIGURATION
# Direct automated server-side WhatsApp OTP delivery (no manual links):
# Meta for Developers -> WhatsApp -> API Setup
# =========================================================================
META_WHATSAPP_TOKEN="EAAG..." # Permanent or System User Access Token
META_PHONE_NUMBER_ID="108923485729102" # Phone Number ID in Meta WhatsApp Cloud Console
META_WABA_ID="109823487291034" # WhatsApp Business Account ID
META_WHATSAPP_TEMPLATE_NAME="sari3_otp_code" # Approved Authentication Template Name
META_WHATSAPP_TEMPLATE_LANG="ar" # Template language (e.g. ar or fr)

